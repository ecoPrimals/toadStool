# ToadStool Workspace Cleanup Configuration
# Last updated: November 4, 2025

# Directories to exclude from searches (reduce false positives)
EXCLUDE_DIRS=(
    "target"
    "node_modules"
    "../archive"
    "coverage/html"
    ".git"
)

# File patterns to ignore
IGNORE_PATTERNS=(
    "*.bak"
    "*.backup"
    "*~"
    ".DS_Store"
    "*.swp"
    "*.swo"
)

# Archive location
ARCHIVE_PATH="../archive/toadstool"

# Clean workspace periodically
# Move old session reports to archive after 30 days
# Keep coverage reports for 7 days
# Clean target/ build artifacts as needed

