# Rust
target/
**/*.rs.bk
*.pdb

# Cargo.lock IS tracked. This workspace ships binaries, so the lockfile is
# part of what makes a build reproducible — and barraCuda, coralReef and
# songBird all track theirs. Leaving it ignored let the dependency graph
# float for the same reason the toolchain did (S382, D-TOOLCHAIN-DRIFT).

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
*.profraw
*.profdata

# Secrets — NEVER commit credentials, tokens, or key material
*.env
.env.*
!.env.example
*-secrets/
*-secrets.*
api-keys*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json

# Temporary
*.tmp
*.log

# Build artifacts
*.o
*.so
*.dylib
*.dll

# Datasets (large binary files, don't commit)
*.ubyte
*.idx3-ubyte
*.idx1-ubyte
*.gz

# Pipeline validation output (generated, not source)
pipeline_validation_actual_hardware.*
actual_gpu_validation.*
benchmark_output.txt
test_results.txt
# Downloaded ML models (too large for git)
models/huggingface/
models/akida/

# Stray build artifacts
rust_out

# Fossilized directories (moved to ecoPrimals/fossil/)
results/
ui/

# VBIOS dumps are NVIDIA firmware — keep them local
testdata/vbios/*.rom
