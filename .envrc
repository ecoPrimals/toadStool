# ToadStool Development Environment
#
# This file sets environment variables for development.
# Use with direnv (https://direnv.net/) or source manually: source .envrc

# Python 3.13 Compatibility
# PyO3 0.20 officially supports up to Python 3.12, but works with 3.13 using ABI3 forward compatibility
export PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1

# Rust Logging
export RUST_LOG=${RUST_LOG:-info}
export RUST_BACKTRACE=${RUST_BACKTRACE:-1}

# ToadStool Configuration
export TOADSTOOL_FAMILY=${TOADSTOOL_FAMILY:-default}

echo "✅ ToadStool development environment loaded"
echo "   Python 3.13 compatibility: enabled"
echo "   Rust log level: $RUST_LOG"
echo "   ToadStool family: $TOADSTOOL_FAMILY"
