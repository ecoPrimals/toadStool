# ToadStool Environment Configuration
# Phase 1: Hardcoding Elimination
#
# All values have sensible defaults. Only override what you need.
# Copy this file to .env and customize for your environment.

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
TOADSTOOL_API_PORT=8080
TOADSTOOL_METRICS_PORT=8083
TOADSTOOL_DISCOVERY_PORT=8084
TOADSTOOL_MONITORING_PORT=8082
TOADSTOOL_REQUEST_TIMEOUT=30
TOADSTOOL_CONNECTION_TIMEOUT=10

# =============================================================================
# DISCOVERY CONFIGURATION
# =============================================================================
TOADSTOOL_DISCOVERY_STRATEGY=multicast
TOADSTOOL_DISCOVERY_INTERVAL=30
TOADSTOOL_ENABLE_MDNS=true

# =============================================================================
# RESOURCE LIMITS
# =============================================================================
TOADSTOOL_CPU_THRESHOLD=80
TOADSTOOL_MEMORY_THRESHOLD=85
TOADSTOOL_DISK_THRESHOLD=90
TOADSTOOL_MAX_CONCURRENT_EXECUTIONS=100

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
TOADSTOOL_COLLECTION_INTERVAL=30
TOADSTOOL_METRICS_RETENTION=3600
TOADSTOOL_ENABLE_DETAILED_METRICS=false
TOADSTOOL_ALERT_CPU_THRESHOLD=90
TOADSTOOL_ALERT_MEMORY_THRESHOLD=95

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
TOADSTOOL_LOG_LEVEL=info
TOADSTOOL_LOG_FORMAT=text
TOADSTOOL_ENABLE_LOG_FILE=false
TOADSTOOL_LOG_FILE_PATH=./logs/toadstool.log

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
TOADSTOOL_ENABLE_TLS=false
# TOADSTOOL_TLS_CERT_PATH=/path/to/cert.pem
# TOADSTOOL_TLS_KEY_PATH=/path/to/key.pem
TOADSTOOL_ENABLE_AUTH=false
# TOADSTOOL_JWT_SECRET=your-secret-key-here

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
DATA_DIR=./data
CACHE_DIR=./cache
TEMP_DIR=./tmp

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================
TOADSTOOL_ENABLE_NATIVE=true
TOADSTOOL_ENABLE_CONTAINER=true
TOADSTOOL_ENABLE_WASM=true
TOADSTOOL_ENABLE_PYTHON=false

# See docs/configuration.md for detailed documentation
