# ToadStool Service Discovery Configuration
# 
# This file configures how ToadStool discovers and connects to ecosystem services.
# Services are discovered by CAPABILITY, not by name.
#
# Copy this file to one of:
#   - ~/.toadstool/services.toml (user-specific)
#   - ./.toadstool/config.toml (project-specific)
#   - /etc/toadstool/services.toml (system-wide)

[discovery]
# Enable environment variable discovery (TOADSTOOL_*_SERVICE_URL)
enable_env = true

# Enable configuration file discovery
enable_config = true

# Enable mDNS/Bonjour discovery (requires mdns feature)
enable_mdns = false

# Enable service mesh discovery (Consul, etcd, K8s)
enable_service_mesh = false

# Discovery timeout in seconds
timeout_seconds = 10

# ===== CRYPTO SERVICES =====
# Any service providing cryptographic capabilities
# Examples: BearDog, AWS KMS, HashiCorp Vault, HSM

[services.crypto]
url = "http://localhost:9876"
priority = 90  # 0-100, higher = preferred
enabled = true
health_check_interval = 30  # seconds

# ===== STORAGE SERVICES =====
# Any service providing storage capabilities
# Examples: NestGate, Ceph, GlusterFS, S3, MinIO

[services.storage]
url = "http://storage.local:8082"
priority = 80
enabled = true
health_check_interval = 60

# ===== COORDINATION SERVICES =====
# Any service providing coordination/discovery capabilities
# Examples: Songbird, Consul, etcd, Kubernetes

[services.coordination]
url = "http://coordinator.local:8080"
priority = 85
enabled = true
health_check_interval = 15

# ===== MESSAGING SERVICES =====
# Any service providing messaging/queue capabilities
# Examples: Squirrel, RabbitMQ, Kafka, Redis

[services.messaging]
url = "http://messaging.local:5672"
priority = 75
enabled = true
health_check_interval = 30

# ===== MULTIPLE PROVIDERS =====
# You can define multiple providers for failover
# ToadStool will try them in priority order

[services.crypto-backup]
url = "https://kms.us-west-2.amazonaws.com"
priority = 50  # Lower priority = backup
enabled = true
health_check_interval = 60

[services.storage-backup]
url = "https://s3.amazonaws.com/my-bucket"
priority = 40
enabled = true
health_check_interval = 120

# ===== METADATA =====
# Add custom metadata to services (optional)

[services.crypto.metadata]
provider = "beardog"
version = "1.0.0"
region = "us-west-2"

[services.storage.metadata]
provider = "nestgate"
filesystem = "zfs"
compression = "lz4"

