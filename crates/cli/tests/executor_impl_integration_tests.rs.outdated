#[tokio::test]
async fn test_execution_request_maximal() {
    // Test execution request with all optional fields set
    let mut env = HashMap::new();
    env.insert("KEY".to_string(), "VALUE".to_string());

    let mut headers = HashMap::new();
    headers.insert("Authorization".to_string(), "Bearer token".to_string());

    let request = ExecutionRequest {
        execution_id: Uuid::new_v4(),
        workload: WorkloadSpec::Container {
            image: "alpine:latest".to_string(),
            command: vec!["sh".to_string(), "-c".to_string(), "echo test".to_string()],
            env: env.clone(),
        },
        runtime_hint: Some(RuntimeType::Container),
        resources: ResourceRequirements {
            cpu: CpuRequirements {
                min_cores: 2.0,
                max_cores: Some(4.0),
                architecture: None,
            },
            memory: MemoryRequirements {
                min_bytes: 1024 * 1024 * 1024,
                max_bytes: Some(2048 * 1024 * 1024),
            },
            storage: StorageRequirements {
                min_bytes: 100 * 1024 * 1024,
                max_bytes: Some(500 * 1024 * 1024),
                storage_type: None,
            },
            gpu: Some(GpuRequirements::default()),
            network: NetworkRequirements::default(),
        },
        security_context: SecurityContext::default(),
        timeout: Some(Duration::from_secs(600)),
        environment: env,
        input_data: vec![1, 2, 3, 4, 5],
        output_config: ExecutionOutputConfig::default(),
        callback_config: Some(CallbackConfig {
            url: "http://callback.example.com/webhook".to_string(),
            method: "POST".to_string(),
            headers,
        }),
    };

    // Verify all fields are set
    assert!(!request.execution_id.is_nil());
    assert!(request.timeout.is_some());
    assert!(request.runtime_hint.is_some());
    assert!(request.callback_config.is_some());
    assert!(!request.input_data.is_empty());
    assert!(!request.environment.is_empty());
    assert!(request.resources.gpu.is_some());
}
