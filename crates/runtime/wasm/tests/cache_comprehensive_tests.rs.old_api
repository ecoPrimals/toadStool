#[tokio::test(flavor = "multi_thread", worker_threads = 8)]
async fn test_concurrent_remove_same_key() {
    let cache = Arc::new(ModuleCache::new(100));
    let barrier = Arc::new(Barrier::new(30));

    let mut handles = vec![];
    let mut results = vec![];

    for _ in 0..30 {
        let cache_clone = Arc::clone(&cache);
        let barrier_clone = Arc::clone(&barrier);

        let handle = tokio::spawn(async move {
            barrier_clone.wait().await;
            cache_clone.remove("same_key").await
        });

        handles.push(handle);
    }

    for handle in handles {
        results.push(handle.await.unwrap());
    }

    // At most one should succeed (if key existed)
    let successful_removes = results.iter().filter(|&&r| r).count();
    assert!(successful_removes <= 1);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 8)]
async fn test_concurrent_operations_consistency() {
    let cache = Arc::new(ModuleCache::new(100));
    let barrier = Arc::new(Barrier::new(80));
    let engine = Arc::new(Engine::default());

    let mut handles = vec![];

    for i in 0..80 {
        let cache_clone = Arc::clone(&cache);
        let barrier_clone = Arc::clone(&barrier);
        let engine_clone = Arc::clone(&engine);

        let handle = tokio::spawn(async move {
            barrier_clone.wait().await;

            // Mix of all operations
            let _ = cache_clone.get(&format!("key_{}", i), &engine_clone).await;
            let _ = cache_clone.len().await;
            let _ = cache_clone.is_empty().await;
            let _ = cache_clone.metrics().await;
            let _ = cache_clone.remove(&format!("key_{}", i)).await;
        });

        handles.push(handle);
    }

    for handle in handles {
        handle.await.unwrap();
    }

    // Final state should be consistent
    let len = cache.len().await;
    let is_empty = cache.is_empty().await;
    assert_eq!(is_empty, len == 0);
}

