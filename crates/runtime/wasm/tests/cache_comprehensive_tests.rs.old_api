#[tokio::test(flavor = "multi_thread", worker_threads = 8)]
async fn test_concurrent_mixed_operations() {
    let cache = Arc::new(ModuleCache::new(100));
    let barrier = Arc::new(Barrier::new(60));
    let engine = Arc::new(Engine::default());

    let mut handles = vec![];

    for i in 0..60 {
        let cache_clone = Arc::clone(&cache);
        let barrier_clone = Arc::clone(&barrier);
        let engine_clone = Arc::clone(&engine);

        let handle = tokio::spawn(async move {
            barrier_clone.wait().await;

            match i % 4 {
                0 => {
                    let _ = cache_clone.get(&format!("key_{}", i), &engine_clone).await;
                }
                1 => {
                    let _ = cache_clone.len().await;
                }
                2 => {
                    let _ = cache_clone.metrics().await;
                }
                _ => {
                    let _ = cache_clone.remove(&format!("key_{}", i)).await;
                }
            }
        });

        handles.push(handle);
    }

    for handle in handles {
        handle.await.unwrap();
    }
}

#[tokio::test(flavor = "multi_thread", worker_threads = 8)]
async fn test_stress_concurrent_gets() {
    let cache = Arc::new(ModuleCache::new(100));
    let barrier = Arc::new(Barrier::new(100));
    let engine = Arc::new(Engine::default());

    let mut handles = vec![];

    for i in 0..100 {
        let cache_clone = Arc::clone(&cache);
        let barrier_clone = Arc::clone(&barrier);
        let engine_clone = Arc::clone(&engine);

        let handle = tokio::spawn(async move {
            barrier_clone.wait().await;
            for j in 0..10 {
                let key = format!("key_{}_{}", i, j);
                let _ = cache_clone.get(&key, &engine_clone).await;
            }
        });

        handles.push(handle);
    }

    for handle in handles {
        handle.await.unwrap();
    }

    // Verify metrics consistency
    let metrics = cache.metrics().await;
    assert!(metrics.cache_hit_rate <= 1.0);
}

