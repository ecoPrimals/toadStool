#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_new() {
    let cache = ModuleCache::new(100);

    assert_eq!(cache.capacity(), 100);
    assert!(cache.is_empty().await);
    assert_eq!(cache.len().await, 0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_capacity_variations() {
    let capacities = vec![1, 10, 100, 1000, 10000];

    for capacity in capacities {
        let cache = ModuleCache::new(capacity);
        assert_eq!(cache.capacity(), capacity);
    }
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_empty_state() {
    let cache = ModuleCache::new(10);

    assert!(cache.is_empty().await);
    assert_eq!(cache.len().await, 0);

    let metrics = cache.metrics().await;
    assert_eq!(metrics.total_modules, 0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_get_miss_on_empty() {
    let cache = ModuleCache::new(10);
    let engine = Engine::default();

    let result = cache.get("nonexistent", &engine).await;

    assert!(result.is_none());

    let metrics = cache.metrics().await;
    assert_eq!(metrics.cache_hit_rate, 0.0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_metrics_empty() {
    let cache = ModuleCache::new(50);
    let metrics = cache.metrics().await;

    assert_eq!(metrics.total_modules, 0);
    assert_eq!(metrics.total_size_bytes, 0);
    assert_eq!(metrics.cache_hit_rate, 0.0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_clear() {
    let cache = ModuleCache::new(10);

    cache.clear().await;

    assert!(cache.is_empty().await);
    assert_eq!(cache.len().await, 0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_remove_nonexistent() {
    let cache = ModuleCache::new(10);

    let removed = cache.remove("nonexistent").await;

    assert!(!removed);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_len_consistency() {
    let cache = ModuleCache::new(10);

    let len1 = cache.len().await;
    let is_empty1 = cache.is_empty().await;

    assert_eq!(len1, 0);
    assert!(is_empty1);

    let len2 = cache.len().await;
    assert_eq!(len1, len2);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_capacity_immutable() {
    let cache = ModuleCache::new(42);

    assert_eq!(cache.capacity(), 42);

    // Capacity should remain constant
    cache.clear().await;
    assert_eq!(cache.capacity(), 42);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_multiple_gets_miss() {
    let cache = ModuleCache::new(10);
    let engine = Engine::default();

    for i in 0..10 {
        let key = format!("key_{}", i);
        let result = cache.get(&key, &engine).await;
        assert!(result.is_none());
    }

    let metrics = cache.metrics().await;
    assert_eq!(metrics.cache_hit_rate, 0.0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_metrics_after_clear() {
    let cache = ModuleCache::new(10);

    cache.clear().await;

    let metrics = cache.metrics().await;
    assert_eq!(metrics.total_modules, 0);
    assert_eq!(metrics.cache_hit_rate, 0.0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_is_empty_after_clear() {
    let cache = ModuleCache::new(10);

    cache.clear().await;

    assert!(cache.is_empty().await);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_len_zero_after_clear() {
    let cache = ModuleCache::new(10);

    cache.clear().await;

    assert_eq!(cache.len().await, 0);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_double_clear() {
    let cache = ModuleCache::new(10);

    cache.clear().await;
    cache.clear().await;

    assert!(cache.is_empty().await);
}

#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn test_module_cache_remove_multiple_times() {
    let cache = ModuleCache::new(10);

    let removed1 = cache.remove("key").await;
    let removed2 = cache.remove("key").await;

    assert!(!removed1);
    assert!(!removed2);
}

// ============================================================================
// Concurrent Access Tests (15 tests)
// ============================================================================

#[tokio::test(flavor = "multi_thread", worker_threads = 8)]
async fn test_concurrent_cache_access_multiple_readers() {
    let cache = Arc::new(ModuleCache::new(100));
    let barrier = Arc::new(Barrier::new(50));
    let engine = Arc::new(Engine::default());

    let mut handles = vec![];

    for i in 0..50 {
        let cache_clone = Arc::clone(&cache);
        let barrier_clone = Arc::clone(&barrier);
        let engine_clone = Arc::clone(&engine);

        let handle = tokio::spawn(async move {
            barrier_clone.wait().await;
            let key = format!("key_{}", i % 10);
            let _ = cache_clone.get(&key, &engine_clone).await;
        });

        handles.push(handle);
    }

    for handle in handles {
        handle.await.unwrap();
    }

    // Verify cache is still functional
    assert_eq!(cache.capacity(), 100);
}

