//! Chaos Engineering and Fault Injection Tests
//!
//! These tests verify system resilience under adverse conditions:
//! - Network failures
//! - Timeout scenarios
//! - Invalid configurations
//! - Concurrent stress
//! - Resource exhaustion

use std::sync::Arc;
use std::time::Duration;
use tokio::sync::RwLock;
use toadstool_runtime_specialty::*;
use uuid::Uuid;

#[tokio::test]
async fn test_invalid_mainframe_host_graceful_failure() {
    // Test that invalid host doesn't panic, returns error
    let config = MainframeConfig {
        host: "invalid.nonexistent.example".to_string(),
        port: 99999, // Invalid port
        system_type: LegacySystemType::IBM_System360,
        connection_pool_size: 1,
        timeout: Duration::from_millis(100), // Very short timeout
        authentication: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::mainframe::ibm::IBMMainframeAdapter::default(),
    ));

    // Should handle gracefully, not panic
    let result = adapter.write().await.initialize(config).await;
    match result {
        Ok(_) => {
            // Initialization succeeded (stub implementation)
            println!("Adapter initialized (stub mode)");
        }
        Err(e) => {
            // Expected error with invalid configuration
            println!("Graceful error handling: {}", e);
        }
    }

    // Shutdown should always succeed
    let _ = adapter.write().await.shutdown().await;
}

#[tokio::test]
async fn test_concurrent_job_submissions_stress() {
    // Submit many jobs concurrently to test thread safety
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::MOS_6502,
        memory_size: 64 * 1024,
        clock_speed_mhz: 1.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::Microcontroller8BitAdapter::default(),
    ));

    adapter.write().await.initialize(config).await.unwrap();

    // Spawn 50 concurrent job submissions
    let mut handles = vec![];
    for i in 0..50 {
        let adapter_clone = Arc::clone(&adapter);
        let handle = tokio::spawn(async move {
            let job = LegacyJob {
                id: Uuid::new_v4(),
                system_type: LegacySystemType::Embedded8Bit,
                source_code: format!("NOP ; Job {}", i),
                language: ProgrammingLanguage::Assembly,
                priority: (i % 10) as u8,
                timeout: Duration::from_secs(30),
                metadata: std::collections::HashMap::new(),
            };

            adapter_clone.write().await.submit_job(job).await
        });
        handles.push(handle);
    }

    // Wait for all jobs
    let mut success_count = 0;
    let mut error_count = 0;
    for handle in handles {
        match handle.await {
            Ok(Ok(_)) => success_count += 1,
            Ok(Err(_)) => error_count += 1,
            Err(_) => error_count += 1,
        }
    }

    println!(
        "Concurrent stress test: {} succeeded, {} failed/expected",
        success_count, error_count
    );

    // System should remain stable
    adapter.write().await.shutdown().await.unwrap();
}

#[tokio::test]
async fn test_zero_timeout_job_handling() {
    // Test job with zero timeout - should handle gracefully
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::Zilog_Z80,
        memory_size: 64 * 1024,
        clock_speed_mhz: 1.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::Microcontroller8BitAdapter::default(),
    ));

    adapter.write().await.initialize(config).await.unwrap();

    let job = LegacyJob {
        id: Uuid::new_v4(),
        system_type: LegacySystemType::Embedded8Bit,
        source_code: "infinite_loop: JMP infinite_loop".to_string(),
        language: ProgrammingLanguage::Assembly,
        priority: 5,
        timeout: Duration::from_secs(0), // Zero timeout!
        metadata: std::collections::HashMap::new(),
    };

    // Should either reject immediately or handle gracefully
    let result = adapter.write().await.submit_job(job).await;
    match result {
        Ok(_) => println!("Job accepted despite zero timeout"),
        Err(e) => println!("Job rejected appropriately: {}", e),
    }

    adapter.write().await.shutdown().await.unwrap();
}

#[tokio::test]
async fn test_malformed_source_code_resilience() {
    // Test that malformed code doesn't crash the runtime
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::Intel_8080,
        memory_size: 64 * 1024,
        clock_speed_mhz: 2.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::Microcontroller8BitAdapter::default(),
    ));

    adapter.write().await.initialize(config).await.unwrap();

    // Submit completely invalid code
    let malformed_codes = vec![
        "completely invalid garbage!@#$%^&*()",
        "",
        "  \n\n\n  ",
        "🚀🔥💻", // Unicode/emoji
        &"A".repeat(1_000_000), // 1MB of 'A'
    ];

    for (i, code) in malformed_codes.iter().enumerate() {
        let job = LegacyJob {
            id: Uuid::new_v4(),
            system_type: LegacySystemType::Embedded8Bit,
            source_code: code.to_string(),
            language: ProgrammingLanguage::Assembly,
            priority: 5,
            timeout: Duration::from_secs(5),
            metadata: std::collections::HashMap::new(),
        };

        // Should handle gracefully, not panic
        let result = adapter.write().await.submit_job(job).await;
        println!(
            "Malformed code test {}: {:?}",
            i + 1,
            result.is_ok().then(|| "accepted").unwrap_or("rejected")
        );
    }

    adapter.write().await.shutdown().await.unwrap();
}

#[tokio::test]
async fn test_adapter_double_initialization() {
    // Test that double initialization is handled properly
    let config = MainframeConfig {
        host: "mainframe.test".to_string(),
        port: 3270,
        system_type: LegacySystemType::VAX_VMS,
        connection_pool_size: 5,
        timeout: Duration::from_secs(30),
        authentication: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::mainframe::vax::VAXVMSAdapter::default(),
    ));

    // First initialization
    adapter
        .write()
        .await
        .initialize(config.clone())
        .await
        .unwrap();

    // Second initialization (should either succeed or return error, not panic)
    let result = adapter.write().await.initialize(config).await;
    match result {
        Ok(_) => println!("Double initialization accepted (re-initialization)"),
        Err(e) => println!("Double initialization rejected: {}", e),
    }

    adapter.write().await.shutdown().await.unwrap();
}

#[tokio::test]
async fn test_shutdown_without_initialization() {
    // Test that shutdown without init doesn't panic
    let adapter = Arc::new(RwLock::new(
        crate::mainframe::ibm::IBMMainframeAdapter::default(),
    ));

    // Shutdown without initialization
    let result = adapter.write().await.shutdown().await;

    // Should either succeed or return error, not panic
    match result {
        Ok(_) => println!("Shutdown without init succeeded (graceful)"),
        Err(e) => println!("Shutdown without init failed gracefully: {}", e),
    }
}

#[tokio::test]
async fn test_rapid_init_shutdown_cycles() {
    // Test rapid initialization and shutdown cycles
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::MOS_6502,
        memory_size: 64 * 1024,
        clock_speed_mhz: 1.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    for i in 0..10 {
        let adapter = Arc::new(RwLock::new(
            crate::embedded::adapters::Microcontroller8BitAdapter::default(),
        ));

        adapter.write().await.initialize(config.clone()).await.unwrap();
        adapter.write().await.shutdown().await.unwrap();

        println!("Completed init/shutdown cycle {}", i + 1);
    }
}

#[tokio::test]
async fn test_extremely_high_priority_job() {
    // Test job with maximum priority value
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::Zilog_Z80,
        memory_size: 64 * 1024,
        clock_speed_mhz: 4.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::Microcontroller8BitAdapter::default(),
    ));

    adapter.write().await.initialize(config).await.unwrap();

    let job = LegacyJob {
        id: Uuid::new_v4(),
        system_type: LegacySystemType::Embedded8Bit,
        source_code: "RET".to_string(),
        language: ProgrammingLanguage::Assembly,
        priority: 255, // Maximum u8 value
        timeout: Duration::from_secs(1),
        metadata: std::collections::HashMap::new(),
    };

    let result = adapter.write().await.submit_job(job).await;
    println!("Extreme priority job: {:?}", result.is_ok());

    adapter.write().await.shutdown().await.unwrap();
}

