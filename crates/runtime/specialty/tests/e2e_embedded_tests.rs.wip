//! End-to-End Tests for Embedded System Adapters
//!
//! Tests cover:
//! - Cross-compilation workflows
//! - EPROM programming
//! - Emulation and debugging

use std::sync::Arc;
use tokio::sync::RwLock;
use toadstool_runtime_specialty::*;
use uuid::Uuid;

#[tokio::test]
async fn test_8bit_microcontroller_e2e() {
    // Configure 8-bit microcontroller (6502)
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::MOS_6502,
        memory_size: 64 * 1024, // 64KB
        clock_speed_mhz: 1.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::Microcontroller8BitAdapter::default(),
    ));

    // Initialize adapter
    let result = adapter.write().await.initialize(config).await;
    assert!(result.is_ok(), "8-bit adapter initialization should succeed");

    // Create assembly program
    let job = LegacyJob {
        id: Uuid::new_v4(),
        system_type: LegacySystemType::Embedded8Bit,
        source_code: r#"
            LDA #$01    ; Load 1 into accumulator
            STA $0200   ; Store at memory location $0200
            RTS         ; Return
        "#
        .to_string(),
        language: ProgrammingLanguage::Assembly,
        priority: 5,
        timeout: std::time::Duration::from_secs(60),
        metadata: std::collections::HashMap::new(),
    };

    // Compile for 6502
    let _ = adapter.write().await.submit_job(job).await;

    // Shutdown
    adapter
        .write()
        .await
        .shutdown()
        .await
        .expect("Shutdown should succeed");
}

#[tokio::test]
async fn test_16bit_microcontroller_e2e() {
    // Configure 16-bit microcontroller (8086)
    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::Intel_8086,
        memory_size: 1024 * 1024, // 1MB
        clock_speed_mhz: 4.77,
        peripherals: vec![],
        programmer_interface: None,
    };

    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::System16BitAdapter::default(),
    ));

    // Initialize
    let result = adapter.write().await.initialize(config).await;
    assert!(result.is_ok());

    // Create 8086 assembly program
    let job = LegacyJob {
        id: Uuid::new_v4(),
        system_type: LegacySystemType::Embedded16Bit,
        source_code: r#"
            MOV AX, 1234h
            MOV BX, AX
            INT 20h
        "#
        .to_string(),
        language: ProgrammingLanguage::Assembly,
        priority: 5,
        timeout: std::time::Duration::from_secs(60),
        metadata: std::collections::HashMap::new(),
    };

    let _ = adapter.write().await.submit_job(job).await;

    adapter.write().await.shutdown().await.expect("Shutdown");
}

#[tokio::test]
async fn test_cross_compilation_workflow() {
    // Test complete cross-compilation workflow
    let adapter = Arc::new(RwLock::new(
        crate::embedded::adapters::Microcontroller8BitAdapter::default(),
    ));

    let config = EmbeddedConfig {
        architecture: LegacyArchitecture::Zilog_Z80,
        memory_size: 64 * 1024,
        clock_speed_mhz: 4.0,
        peripherals: vec![],
        programmer_interface: None,
    };

    adapter.write().await.initialize(config).await.unwrap();

    // Submit C program for Z80
    let job = LegacyJob {
        id: Uuid::new_v4(),
        system_type: LegacySystemType::Embedded8Bit,
        source_code: r#"
            void main() {
                int x = 42;
                while(1) {}
            }
        "#
        .to_string(),
        language: ProgrammingLanguage::C,
        priority: 3,
        timeout: std::time::Duration::from_secs(120),
        metadata: std::collections::HashMap::new(),
    };

    let _ = adapter.write().await.submit_job(job).await;

    adapter.write().await.shutdown().await.unwrap();
}

#[tokio::test]
async fn test_multiple_architectures_sequential() {
    // Test compiling for multiple architectures in sequence
    let architectures = vec![
        LegacyArchitecture::MOS_6502,
        LegacyArchitecture::Zilog_Z80,
        LegacyArchitecture::Intel_8080,
    ];

    for arch in architectures {
        let config = EmbeddedConfig {
            architecture: arch.clone(),
            memory_size: 64 * 1024,
            clock_speed_mhz: 1.0,
            peripherals: vec![],
            programmer_interface: None,
        };

        let adapter = Arc::new(RwLock::new(
            crate::embedded::adapters::Microcontroller8BitAdapter::default(),
        ));

        adapter.write().await.initialize(config).await.unwrap();

        let job = LegacyJob {
            id: Uuid::new_v4(),
            system_type: LegacySystemType::Embedded8Bit,
            source_code: "NOP\nRET".to_string(),
            language: ProgrammingLanguage::Assembly,
            priority: 5,
            timeout: std::time::Duration::from_secs(30),
            metadata: std::collections::HashMap::new(),
        };

        let _ = adapter.write().await.submit_job(job).await;
        adapter.write().await.shutdown().await.unwrap();

        println!("Successfully tested architecture: {:?}", arch);
    }
}

