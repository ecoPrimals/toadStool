#[tokio::test]
async fn test_policy_lifecycle() {
    let config = create_test_config();
    let manager = FilePolicyManager::new(config).expect("Failed to create manager");
    
    let policy = create_test_policy("lifecycle-policy");
    let policy_id = policy.id.clone();
    
    // 1. Load policy
    let load_result = manager.load_policy(policy.clone()).await;
    assert!(load_result.is_ok());
    
    // 2. Evaluate policy
    let context = PolicyEvaluationContext {
        workload: create_test_workload_spec(),
        security_context: create_test_security_context(),
        requested_capabilities: std::collections::HashSet::new(),
        user_info: None,
        system_info: create_test_system_info(),
        timestamp: std::time::SystemTime::now(),
        variables: HashMap::new(),
    };
    
    let eval_result = manager.evaluate_policy(&policy_id, &context).await;
    assert!(eval_result.is_ok());
    
    // 3. Unload policy (if supported)
    // This is a lifecycle test, exact API depends on implementation
}

#[tokio::test]
async fn test_policy_manager_stress() {
    let config = create_test_config();
    let manager = std::sync::Arc::new(FilePolicyManager::new(config).expect("Failed to create manager"));
    
    // Load 50 policies
    for i in 1..=50 {
        let policy = create_test_policy(&format!("stress-policy-{}", i));
        let result = manager.load_policy(policy).await;
        assert!(result.is_ok());
    }
    
    // Evaluate them concurrently
    let mut handles = vec![];
    for i in 1..=50 {
        let manager_clone = manager.clone();
        let handle = tokio::spawn(async move {
            let context = PolicyEvaluationContext {
                workload: create_test_workload_spec(),
                security_context: create_test_security_context(),
                requested_capabilities: std::collections::HashSet::new(),
                user_info: None,
                system_info: create_test_system_info(),
                timestamp: std::time::SystemTime::now(),
                variables: HashMap::new(),
            };
            manager_clone
                .evaluate_policy(&format!("stress-policy-{}", i), &context)
                .await
        });
        handles.push(handle);
    }
    
    // Verify all succeeded
    for handle in handles {
        let result = handle.await.unwrap();
        assert!(result.is_ok());
    }
}

