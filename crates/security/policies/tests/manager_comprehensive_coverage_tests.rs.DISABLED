#[tokio::test]
async fn test_evaluate_policy_with_warnings() {
    let config = create_test_config();
    let manager = FilePolicyManager::new(config).expect("Failed to create manager");
    
    let mut policy = create_test_policy("warning-policy");
    policy.rules = vec![PolicyRule {
        id: "warning-rule".to_string(),
        name: "Warning Rule".to_string(),
        condition: PolicyCondition::Always,
        action: PolicyAction::AllowWithWarning {
            message: "This is a test warning".to_string(),
        },
        priority: 100,
        enabled: true,
        description: None,
    }];
    
    manager.load_policy(policy.clone()).await.unwrap();
    
    let context = PolicyEvaluationContext {
        workload: create_test_workload_spec(),
        security_context: create_test_security_context(),
        requested_capabilities: std::collections::HashSet::new(),
        user_info: None,
        system_info: create_test_system_info(),
        timestamp: std::time::SystemTime::now(),
        variables: HashMap::new(),
    };
    
    let result = manager.evaluate_policy(&policy.id, &context).await;
    
    assert!(result.is_ok());
    let eval_result = result.unwrap();
    assert_eq!(eval_result.result, PolicyResult::Allow);
    assert!(!eval_result.warnings.is_empty());
}

#[tokio::test]
async fn test_evaluate_nonexistent_policy() {
    let config = create_test_config();
    let manager = FilePolicyManager::new(config).expect("Failed to create manager");
    
    let context = PolicyEvaluationContext {
        workload: create_test_workload_spec(),
        security_context: create_test_security_context(),
        requested_capabilities: std::collections::HashSet::new(),
        user_info: None,
        system_info: create_test_system_info(),
        timestamp: std::time::SystemTime::now(),
        variables: HashMap::new(),
    };
    
    let result = manager.evaluate_policy("nonexistent", &context).await;
    
    // Should return error for nonexistent policy
    assert!(result.is_err());
}

// ============================================================================
// Policy Rule Priority Tests
// ============================================================================

#[tokio::test]
async fn test_rule_priority_ordering() {
    let config = create_test_config();
    let manager = FilePolicyManager::new(config).expect("Failed to create manager");
    
    let mut policy = create_test_policy("priority-policy");
    policy.rules = vec![
        PolicyRule {
            id: "low-priority".to_string(),
            name: "Low Priority Rule".to_string(),
            condition: PolicyCondition::Always,
            action: PolicyAction::Deny,
            priority: 10,
            enabled: true,
            description: None,
        },
        PolicyRule {
            id: "high-priority".to_string(),
            name: "High Priority Rule".to_string(),
            condition: PolicyCondition::Always,
            action: PolicyAction::Allow,
            priority: 100,
            enabled: true,
            description: None,
        },
    ];
    
    manager.load_policy(policy.clone()).await.unwrap();
    
    let context = PolicyEvaluationContext {
        workload: create_test_workload_spec(),
        security_context: create_test_security_context(),
        requested_capabilities: std::collections::HashSet::new(),
        user_info: None,
        system_info: create_test_system_info(),
        timestamp: std::time::SystemTime::now(),
        variables: HashMap::new(),
    };
    
    let result = manager.evaluate_policy(&policy.id, &context).await;
    
    assert!(result.is_ok());
    let eval_result = result.unwrap();
    // Higher priority rule should win
    assert_eq!(eval_result.result, PolicyResult::Allow);
}

// ============================================================================
// Cache Tests
// ============================================================================

#[tokio::test]
async fn test_policy_caching_enabled() {
    let mut config = create_test_config();
    config.cache_enabled = true;
    config.cache_ttl_hours = 1;
    
    let manager = FilePolicyManager::new(config).expect("Failed to create manager");
    let policy = create_test_policy("cached-policy");
    
    // Load policy twice - second should use cache
    manager.load_policy(policy.clone()).await.unwrap();
    
    let result = manager.load_policy(policy).await;
    assert!(result.is_ok());
}

#[tokio::test]
async fn test_policy_caching_disabled() {
    let mut config = create_test_config();
    config.cache_enabled = false;
    
    let manager = FilePolicyManager::new(config).expect("Failed to create manager");
    let policy = create_test_policy("uncached-policy");
    
    // Load policy twice - should process both times
    manager.load_policy(policy.clone()).await.unwrap();
    
    let result = manager.load_policy(policy).await;
    assert!(result.is_ok());
}

// ============================================================================
// Concurrent Access Tests
// ============================================================================

#[tokio::test]
async fn test_concurrent_policy_loading() {
    let config = create_test_config();
    let manager = std::sync::Arc::new(FilePolicyManager::new(config).expect("Failed to create manager"));
    
    let mut handles = vec![];
    
    for i in 1..=10 {
        let manager_clone = manager.clone();
        let handle = tokio::spawn(async move {
            let policy = create_test_policy(&format!("concurrent-{}", i));
            manager_clone.load_policy(policy).await
        });
        handles.push(handle);
    }
    
    // Wait for all tasks
    for handle in handles {
        let result = handle.await.unwrap();
        assert!(result.is_ok());
    }
}

#[tokio::test]
async fn test_concurrent_policy_evaluation() {
    let config = create_test_config();
    let manager = std::sync::Arc::new(FilePolicyManager::new(config).expect("Failed to create manager"));
    
    let policy = create_test_policy("shared-policy");
    manager.load_policy(policy.clone()).await.unwrap();
    
    let mut handles = vec![];
    
    for _ in 1..=10 {
        let manager_clone = manager.clone();
        let policy_id = policy.id.clone();
        let handle = tokio::spawn(async move {
            let context = PolicyEvaluationContext {
                workload: create_test_workload_spec(),
                security_context: create_test_security_context(),
                requested_capabilities: std::collections::HashSet::new(),
                user_info: None,
                system_info: create_test_system_info(),
                timestamp: std::time::SystemTime::now(),
                variables: HashMap::new(),
            };
            manager_clone.evaluate_policy(&policy_id, &context).await
        });
        handles.push(handle);
    }
    
    // Wait for all evaluations
    for handle in handles {
        let result = handle.await.unwrap();
        assert!(result.is_ok());
    }
}

