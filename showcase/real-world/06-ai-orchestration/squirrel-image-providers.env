# Squirrel Image Generation Provider Discovery
# Providers discovered at runtime via environment - no hardcoding!
# Load this file before starting Squirrel

# Load API keys from testing-secrets
source /home/eastgate/Development/ecoPrimals/testing-secrets/api-keys.env 2>/dev/null || true

# ═══════════════════════════════════════════════════════════════
# Provider 1: High Quality Image Generation
# ═══════════════════════════════════════════════════════════════

CAPABILITY_IMAGE_GENERATION_1_TYPE=image.generation
CAPABILITY_IMAGE_GENERATION_1_ENDPOINT=https://api.openai.com/v1/images/generations
CAPABILITY_IMAGE_GENERATION_1_METHOD=POST
CAPABILITY_IMAGE_GENERATION_1_AUTH_TYPE=bearer
CAPABILITY_IMAGE_GENERATION_1_AUTH_KEY=${OPENAI_API_KEY}
CAPABILITY_IMAGE_GENERATION_1_COST=0.02
CAPABILITY_IMAGE_GENERATION_1_QUALITY=high
CAPABILITY_IMAGE_GENERATION_1_LATENCY_MS=12000
CAPABILITY_IMAGE_GENERATION_1_RELIABILITY=0.99
CAPABILITY_IMAGE_GENERATION_1_FORMATS=png
CAPABILITY_IMAGE_GENERATION_1_MAX_RESOLUTION=1024x1024
CAPABILITY_IMAGE_GENERATION_1_PRIVACY=cloud
CAPABILITY_IMAGE_GENERATION_1_RETENTION=none
CAPABILITY_IMAGE_GENERATION_1_REQUEST_PROMPT_FIELD=prompt
CAPABILITY_IMAGE_GENERATION_1_REQUEST_SIZE_FIELD=size
CAPABILITY_IMAGE_GENERATION_1_RESPONSE_URL_PATH=data[0].url

# ═══════════════════════════════════════════════════════════════
# Provider 2: Free Image Generation (Fixed Router!)
# ═══════════════════════════════════════════════════════════════

CAPABILITY_IMAGE_GENERATION_2_TYPE=image.generation
CAPABILITY_IMAGE_GENERATION_2_ENDPOINT=https://router.huggingface.co/models/runwayml/stable-diffusion-v1-5
CAPABILITY_IMAGE_GENERATION_2_METHOD=POST
CAPABILITY_IMAGE_GENERATION_2_AUTH_TYPE=bearer
CAPABILITY_IMAGE_GENERATION_2_AUTH_KEY=${HUGGINGFACE_API_KEY}
CAPABILITY_IMAGE_GENERATION_2_COST=0.00
CAPABILITY_IMAGE_GENERATION_2_QUALITY=medium
CAPABILITY_IMAGE_GENERATION_2_LATENCY_MS=45000
CAPABILITY_IMAGE_GENERATION_2_RELIABILITY=0.85
CAPABILITY_IMAGE_GENERATION_2_FORMATS=png,jpg
CAPABILITY_IMAGE_GENERATION_2_MAX_RESOLUTION=768x768
CAPABILITY_IMAGE_GENERATION_2_PRIVACY=cloud
CAPABILITY_IMAGE_GENERATION_2_RETENTION=temporary
CAPABILITY_IMAGE_GENERATION_2_REQUEST_PROMPT_FIELD=inputs
CAPABILITY_IMAGE_GENERATION_2_RESPONSE_FORMAT=binary
CAPABILITY_IMAGE_GENERATION_2_COLD_START=true
CAPABILITY_IMAGE_GENERATION_2_COLD_START_MAX_MS=60000

# ═══════════════════════════════════════════════════════════════
# Discovery Configuration
# ═══════════════════════════════════════════════════════════════

SQUIRREL_CAPABILITY_DISCOVERY_ENABLED=true
SQUIRREL_CAPABILITY_DISCOVERY_METHODS=environment,config
SQUIRREL_CAPABILITY_REFRESH_INTERVAL_MS=60000
SQUIRREL_CAPABILITY_CACHE_ENABLED=true
SQUIRREL_CAPABILITY_CACHE_TTL_MS=30000

# ═══════════════════════════════════════════════════════════════
# Songbird Integration
# ═══════════════════════════════════════════════════════════════

SONGBIRD_ENABLED=true
SONGBIRD_ENDPOINT=http://localhost:8080
SONGBIRD_AUTO_REGISTER=true
SONGBIRD_HEARTBEAT_INTERVAL_MS=30000

# Register Squirrel as AI capability provider with Songbird
SONGBIRD_REGISTER_CAPABILITY=ai.inference
SONGBIRD_REGISTER_CAPABILITY=ai.image.generation
SONGBIRD_REGISTER_CAPABILITY=ai.text.generation

# ═══════════════════════════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════════════════════════

# Router endpoint for HuggingFace was updated from:
#   OLD: https://api-inference.huggingface.co
#   NEW: https://router.huggingface.co
# 
# This change is transparent to:
#   - Demo (only knows Squirrel API)
#   - Squirrel core (uses capability discovery)
#   - ToadStool (orchestrates via Squirrel)
#
# Only this config file needed updating!

